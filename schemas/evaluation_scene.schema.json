{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://3wa.example/schemas/evaluation_scene.schema.json",
  "title": "3waPlateAI evaluation scene",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scene_id", "source_id", "image", "plates"],
  "properties": {
    "schema_version": {"const": 1},
    "scene_id": {"$ref": "#/$defs/id"},
    "source_id": {"$ref": "#/$defs/id"},
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "width", "height"],
      "properties": {
        "path": {"$ref": "#/$defs/safe_path"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1}
      }
    },
    "plates": {
      "type": "array",
      "items": {"$ref": "#/$defs/plate"}
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "safe_path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*\\u0000).+$"},
    "corner": {
      "type": "array",
      "prefixItems": [{"type": "number", "minimum": 0}, {"type": "number", "minimum": 0}],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "corners": {
      "type": "array",
      "prefixItems": [
        {"$ref": "#/$defs/corner"},
        {"$ref": "#/$defs/corner"},
        {"$ref": "#/$defs/corner"},
        {"$ref": "#/$defs/corner"}
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "plate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instance_id", "corners", "geometry_provenance", "geometry_audited", "text_audited"],
      "properties": {
        "instance_id": {"$ref": "#/$defs/id"},
        "corners": {"$ref": "#/$defs/corners"},
        "canonical": {"type": "string", "minLength": 1},
        "display": {"type": "string", "minLength": 1},
        "rule_id": {"$ref": "#/$defs/id"},
        "plate_type": {"$ref": "#/$defs/id"},
        "geometry_provenance": {"type": "string", "minLength": 1},
        "geometry_audited": {"type": "boolean"},
        "text_provenance": {"type": "string", "minLength": 1},
        "text_audited": {"type": "boolean"}
      }
    }
  }
}
