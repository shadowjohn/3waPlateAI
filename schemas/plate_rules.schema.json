{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "3waPlateAI plate rules",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "character_classes", "rules"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "minLength": 1},
    "character_classes": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[A-Za-z][A-Za-z0-9_-]*$"},
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "tokens", "separator", "separator_after", "plate_type", "weight", "enabled"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "tokens": {
            "type": "array",
            "minItems": 1,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["class"],
                  "properties": {"class": {"type": "string", "minLength": 1}}
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["literal"],
                  "properties": {"literal": {"type": "string", "minLength": 1, "maxLength": 1}}
                }
              ]
            }
          },
          "separator": {"type": "string", "minLength": 1, "maxLength": 1},
          "separator_after": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "integer", "minimum": 1}
          },
          "plate_type": {"type": "string", "minLength": 1},
          "weight": {"type": "number"},
          "enabled": {"type": "boolean"}
        },
        "allOf": [
          {
            "if": {"properties": {"enabled": {"const": true}}, "required": ["enabled"]},
            "then": {"properties": {"weight": {"exclusiveMinimum": 0}}}
          }
        ]
      }
    }
  }
}
