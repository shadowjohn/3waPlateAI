{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "3waPlateAI Model Bundle manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "model_id", "version", "created_at", "capabilities", "plate_size", "charset", "rules", "components", "decoder", "preprocess", "provenance"],
  "properties": {
    "schema_version": {"const": 1},
    "contract_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "model_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"},
    "created_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["crop-recognition", "plate-detection"]},
      "contains": {"const": "crop-recognition"}
    },
    "plate_size": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"type": "integer", "minimum": 1}
    },
    "charset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "sha256", "visible_symbols"],
      "properties": {
        "file": {"$ref": "#/$defs/file_name"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "visible_symbols": {"type": "integer", "minimum": 1}
      }
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "sha256"],
      "properties": {
        "file": {"$ref": "#/$defs/file_name"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recognizer"],
      "properties": {
        "recognizer": {"$ref": "#/$defs/recognizer"},
        "detector": {"$ref": "#/$defs/detector"}
      }
    },
    "decoder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "blank_index", "class_count", "index_mapping", "collapse_repeats"],
      "properties": {
        "type": {"const": "ctc"},
        "blank_index": {"type": "integer", "minimum": 0},
        "class_count": {"type": "integer", "minimum": 2},
        "index_mapping": {"const": "charset-order-skipping-blank"},
        "collapse_repeats": {"const": true}
      }
    },
    "preprocess": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_size_wh", "color_space", "layout", "input_size_hw", "grayscale", "resize", "normalization"],
      "properties": {
        "source_size_wh": {"const": [380, 160]},
        "color_space": {"const": "grayscale"},
        "layout": {"const": "NCHW"},
        "input_size_hw": {"const": [64, 160]},
        "grayscale": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reference", "library_version"],
          "properties": {
            "reference": {"const": "pillow-image-convert-l"},
            "library_version": {"const": "12.3.0"}
          }
        },
        "resize": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "reference", "interpolation", "library_version", "resized_size_hw", "padding_ltrb", "padding_raw_value"],
          "properties": {
            "mode": {"const": "letterbox"},
            "reference": {"const": "pillow-image-resize"},
            "interpolation": {"const": "Resampling.BILINEAR"},
            "library_version": {"const": "12.3.0"},
            "resized_size_hw": {"const": [64, 152]},
            "padding_ltrb": {"const": [4, 0, 4, 0]},
            "padding_raw_value": {"const": 255}
          }
        },
        "normalization": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "divisor", "dtype"],
          "properties": {
            "type": {"const": "divide"},
            "divisor": {"const": 255.0},
            "dtype": {"const": "float32"}
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["training_data", "license_reviewed", "training_report"],
      "properties": {
        "training_data": {"enum": ["synthetic", "mixed", "real"]},
        "license_reviewed": {"type": "boolean"},
        "training_report": {
          "type": "object",
          "additionalProperties": false,
          "required": ["file", "sha256"],
          "properties": {
            "file": {"$ref": "#/$defs/file_name"},
            "sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "detector_training_report": {
          "type": "object",
          "additionalProperties": false,
          "required": ["file", "sha256"],
          "properties": {
            "file": {"$ref": "#/$defs/file_name"},
            "sha256": {"$ref": "#/$defs/sha256"}
          }
        }
      }
    },
    "rectifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["normalization_strategy"],
      "properties": {
        "normalization_strategy": {"const": "convex-hull-semantic-v1"}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"capabilities": {"contains": {"const": "plate-detection"}}},
        "required": ["capabilities"]
      },
      "then": {
        "required": ["rectifier"],
        "properties": {
          "capabilities": {"minItems": 2, "maxItems": 2},
          "components": {"required": ["detector"]},
          "provenance": {"required": ["detector_training_report"]}
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "file_name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "tensor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "dtype", "shape"],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"},
        "dtype": {"enum": ["float32", "float16", "uint8", "int32", "int64"]},
        "shape": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {"type": "integer", "minimum": 1},
              {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
            ]
          }
        }
      }
    },
    "dynamic_batch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "min", "opt", "max"],
      "properties": {
        "mode": {"const": "dynamic"},
        "min": {"type": "integer", "minimum": 1},
        "opt": {"type": "integer", "minimum": 1},
        "max": {"type": "integer", "minimum": 1}
      }
    },
    "fixed_batch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "size", "padding", "discard_padded_outputs"],
      "properties": {
        "mode": {"const": "fixed"},
        "size": {"type": "integer", "minimum": 1},
        "padding": {"const": "neutral-image"},
        "discard_padded_outputs": {"const": true}
      }
    },
    "recognizer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "format", "sha256", "inputs", "outputs", "batch"],
      "properties": {
        "file": {"$ref": "#/$defs/file_name"},
        "format": {"enum": ["onnx", "tensorrt"]},
        "sha256": {"$ref": "#/$defs/sha256"},
        "inputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/tensor"}},
        "outputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/tensor"}},
        "batch": {"oneOf": [{"$ref": "#/$defs/dynamic_batch"}, {"$ref": "#/$defs/fixed_batch"}]}
      }
    },
    "detector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "format", "sha256", "inputs", "outputs", "batch", "keypoints", "postprocess"],
      "properties": {
        "file": {"$ref": "#/$defs/file_name"},
        "format": {"const": "onnx"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "inputs": {"const": [{"name": "images", "dtype": "float32", "shape": ["batch", 3, 640, 640]}]},
        "outputs": {"const": [{"name": "candidates", "dtype": "float32", "shape": ["batch", 8400, 13]}]},
        "batch": {"const": {"mode": "dynamic", "min": 1, "opt": 8, "max": 32}},
        "postprocess": {
          "type": "object",
          "additionalProperties": false,
          "required": ["candidate_format", "preprocess", "nms", "score_threshold", "iou_threshold", "max_detections"],
          "properties": {
            "candidate_format": {"const": "cxcywh-confidence-corners-letterbox-px-v1"},
            "preprocess": {"const": "opencv-rgb-letterbox-640-v1"},
            "nms": {"const": "numpy-nms-v1"},
            "score_threshold": {"const": 0.25},
            "iou_threshold": {"const": 0.50},
            "max_detections": {"const": 100}
          }
        },
        "keypoints": {
          "type": "array",
          "prefixItems": [
            {"const": "left_top"},
            {"const": "right_top"},
            {"const": "right_bottom"},
            {"const": "left_bottom"}
          ],
          "items": false,
          "minItems": 4,
          "maxItems": 4
        }
      }
    }
  }
}
