{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "3waPlateAI detection background manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "backgrounds"],
  "properties": {
    "schema_version": {"const": 1},
    "backgrounds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["image_path", "sha256"],
        "properties": {
          "image_path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?![A-Za-z]:)(?![\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+$"
          },
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
